# Copy this file to .env and fill in the real values.
# .env is ignored by git and must never be committed.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1

# --- Database ---
# Replace CHANGEME with the password for your local PostgreSQL role.
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/bloodnet
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/bloodnet_test

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGEME
JWT_SECRET_KEY=CHANGEME

# Token lifetimes, in seconds. Access tokens are deliberately short because they
# are held in browser memory and are not blocklist-checked on every request.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Set to 1 in any environment served over HTTPS so the refresh cookie carries
# the Secure attribute. Left at 0 for local development over plain HTTP.
JWT_COOKIE_SECURE=0

# --- CORS ---
# Origin of the Vite development server.
CORS_ORIGINS=http://localhost:5173

# --- Initial administrator ---
# Consumed once by "flask seed-admin". There is no public sign-up for the admin
# role, so this is how the first account comes into existence.
ADMIN_EMAIL=admin@bloodnet.local
ADMIN_PASSWORD=CHANGEME
ADMIN_NAME=Network Administrator

# --- Notifications ---
# Driver used to deliver broadcast notifications: console or smtp.
# The notifications table is the source of truth regardless of driver.
NOTIFIER_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bloodnet@example.org
SMTP_USE_TLS=1

# --- Donation eligibility rules ---
# Whole blood inter-donation intervals, in days.
COOLDOWN_DAYS_MALE=90
COOLDOWN_DAYS_FEMALE=120
MIN_DONOR_AGE=18
MAX_DONOR_AGE=65
MIN_DONOR_WEIGHT_KG=45
